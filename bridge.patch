index 0000000..d097186
--- /dev/null
+++ b/patches/bridge_crane.s
@@ -0,0 +1,64 @@
+/* Pretendo Bridge: leave a crane machine with B (or the Back button) while
+ * paid plays remain. The remaining plays are dropped: the session ends the
+ * same way the game ends it after its last play.
+ *
+ * Addresses are 1.3.0 values; src/badge_patch.py maps them for 1.3.1, like
+ * patches/badge_offline.s. The code lives in the dead body of the SDK's
+ * SOC GetHostByName (its entry already branches to badge_soc_unavailable).
+ *
+ * Crane bottom screen (CraneGameScreenD): state at +0x208, result at +0x204,
+ * remaining plays at +0x218. State 9 = paid, waiting for the next play.
+ * Crane task: screen at +0x234, play session at +0x188.
+ */
+    .syntax unified
+    .arm
+    .text
+
+    /* Game functions, resolved by src/bridge_crane.py (1.3.0 / 1.3.1):
+     * SET_STATE (state*, new), PLAY_DONE (screen: one play over; r2 != 0 ends
+     * the session), SESSION_REMAINING (session, remaining), GLOBAL_REMAINING
+     * (*0x42b28c, remaining), SESSION_END (task: bookkeeping, save, next task
+     * state), SCREEN_EVENT_EXIT (exit of the button-release handler). */
+
+/* Replaces "blx r1" (screen->GetResult) at the top of the crane task update.
+ * r0 = screen, r1 = GetResult, r4 = task (the caller's, preserved here). */
+.global bridge_crane_result
+bridge_crane_result:
+    push {r4, r5, r6, lr}
+    blx r1
+    cmp r0, #2                    /* Back */
+    bne .Lresult_done
+    ldr r5, [r4, #0x234]
+    ldr r1, [r5, #0x208]
+    cmp r1, #9                    /* while paid plays remain */
+    bne .Lresult_done
+    add r0, r5, #0x208            /* PLAY_DONE only acts in state 0xa */
+    mov r1, #0xa
+    bl SET_STATE
+    mov r0, r5
+    ldr r1, [r4, #0x19c]
+    mov r2, #1                    /* end now: remaining 0, state 0xb (r3 unused then) */
+    bl PLAY_DONE
+    ldr r0, [r4, #0x188]
+    ldr r1, [r5, #0x218]
+    bl SESSION_REMAINING
+    ldr r0, .Lglobal
+    ldr r0, [r0]
+    ldr r1, [r5, #0x218]
+    bl GLOBAL_REMAINING
+    mov r0, r4
+    bl SESSION_END                /* state 0xb: the normal end of a session */
+    mov r0, #0                    /* nothing else to handle this frame */
+.Lresult_done:
+    pop {r4, r5, r6, pc}
+
+/* State 9 in the screen's button-release handler: r0 = button id, r4 = screen.
+ * Report Back (button 2, also pressed by B) like state 1 does. */
+.global bridge_crane_back
+bridge_crane_back:
+    cmp r0, #2
+    streq r0, [r4, #0x204]
+    b SCREEN_EVENT_EXIT
+
+.Lglobal:
+    .word 0x42b28c
