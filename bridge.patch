diff --git a/tests/test_bridge_crane.py b/tests/test_bridge_crane.py
new file mode 100644
index 0000000..3ce4b8d
--- /dev/null
+++ b/tests/test_bridge_crane.py
@@ -0,0 +1,114 @@
+"""Pretendo Bridge: B at the crane while paid plays remain (src/bridge_crane.py).
+
+Runs the patched executables in the same emulator as test_badge_patch.py.
+"""
+import struct
+
+import pytest
+from unicorn.arm_const import UC_ARM_REG_LR, UC_ARM_REG_PC, UC_ARM_REG_R0, UC_ARM_REG_R1, UC_ARM_REG_R4, UC_ARM_REG_SP
+
+from bridge_crane import BACK_ENABLED, BACK_SHOWN, CAVE
+from test_badge_patch import (  # noqa: F401 (pytest fixtures)
+    PRESERVED, STACK, STOP, BadgeMachine, badge_code, badge_records, badge_revision, home_menu,
+    home_variant_requirement,
+)
+
+SCREEN = 0x780000
+EVENT = 0x790000
+TASK = 0x7A0000
+SESSION = 0x7B0000
+GLOBAL = 0x7C0000
+GETTER = 0x7D0000
+
+RELEASE_HANDLER = 0x2F9848  # CraneGameScreenD button-release handler
+PANE_UPDATE = 0x2411BC      # its tail call
+PLAY_DONE, SESSION_REMAINING, GLOBAL_REMAINING, SESSION_END = 0x2F9534, 0x2554A4, 0x252AA8, 0x2E312C
+
+
+def release(m, state, button):
+    m.put(SCREEN + 0x204, 0)
+    m.put(SCREEN + 0x208, state)
+    m.uc.mem_write(EVENT + 0x16, b"\x10")
+    m.put(EVENT + 0x20, button)
+    m.boundaries[PANE_UPDATE] = lambda: None
+    m.run(RELEASE_HANDLER, SCREEN, EVENT)
+    return m.word(SCREEN + 0x204), m.word(SCREEN + 0x208)
+
+
+def test_back_is_reported_while_plays_remain(badge_code):
+    assert release(BadgeMachine(badge_code), 9, 2) == (2, 9)
+
+
+@pytest.mark.parametrize("state,button,expected", [
+    (1, 2, (2, 2)),    # Back without a session, as before
+    (9, 6, (6, 0xF)),  # the rabbit still works with plays left
+    (9, 4, (0, 9)),    # L/R are not this handler's business
+])
+def test_other_buttons_behave_as_before(badge_code, state, button, expected):
+    assert release(BadgeMachine(badge_code), state, button) == expected
+
+
+def test_crane_records_do_not_overlap_other_records(badge_records):
+    spans = sorted((a, a + len(b)) for a, b in badge_records[0])
+    assert all(end <= start for (_, end), (start, _) in zip(spans, spans[1:]))
+
+
+def test_state9_keeps_back_visible_and_enabled(badge_code):
+    revision = badge_code.revision
+    word = lambda a: struct.unpack_from("<I", badge_code, revision.address(a) - 0x100000)[0]
+    assert word(BACK_SHOWN) == 0xE3A01001    # SetVisible(1)
+    assert word(BACK_ENABLED) == 0xE3A01000  # SetDisabled(0)
+
+
+def run_result(m, result, state, remaining=3):
+    """Run the hooked GetResult call with the crane task in r4."""
+    m.uc.mem_write(GETTER, bytes.fromhex("040290e5 1eff2fe1"))  # ldr r0, [r0, #0x204]; bx lr
+    m.put(TASK + 0x234, SCREEN)
+    m.put(TASK + 0x19C, 0)
+    m.put(TASK + 0x188, SESSION)
+    m.put(0x42B28C, GLOBAL)
+    m.put(SCREEN + 0x204, result)
+    m.put(SCREEN + 0x208, state)
+    m.put(SCREEN + 0x218, remaining)
+    seen = []
+
+    def play_done():
+        seen.append(("play_done", m.reg(0), m.reg(2), m.word(SCREEN + 0x208)))
+        m.put(SCREEN + 0x218, 0)
+        m.put(SCREEN + 0x208, 0xB)
+
+    m.boundaries.update({
+        PLAY_DONE: play_done,
+        SESSION_REMAINING: lambda: seen.append(("session_remaining", m.reg(0), m.reg(1))),
+        GLOBAL_REMAINING: lambda: seen.append(("global_remaining", m.reg(0), m.reg(1))),
+        SESSION_END: lambda: seen.append(("session_end", m.reg(0), m.word(SCREEN + 0x208))),
+    })
+    m.uc.reg_write(UC_ARM_REG_SP, STACK)
+    m.uc.reg_write(UC_ARM_REG_LR, STOP)
+    for i, register in enumerate(PRESERVED):
+        m.uc.reg_write(register, 0xABC000 + i)
+    m.uc.reg_write(UC_ARM_REG_R0, SCREEN)
+    m.uc.reg_write(UC_ARM_REG_R1, GETTER)
+    m.uc.reg_write(UC_ARM_REG_R4, TASK)
+    m.uc.emu_start(m.native(CAVE), STOP + 4, count=200000)
+    assert m.uc.reg_read(UC_ARM_REG_PC) == STOP
+    assert m.uc.reg_read(UC_ARM_REG_SP) == STACK
+    assert m.uc.reg_read(UC_ARM_REG_R4) == TASK
+    return m.reg(0), seen
+
+
+def test_back_with_plays_left_ends_the_session(badge_code):
+    result, seen = run_result(BadgeMachine(badge_code), 2, 9)
+    assert result == 0  # handled: no Back this frame
+    assert seen == [
+        ("play_done", SCREEN, 1, 0xA),        # ends now, from the state it expects
+        ("session_remaining", SESSION, 0),
+        ("global_remaining", GLOBAL, 0),
+        ("session_end", TASK, 0xB),           # the game's own end of a session
+    ]
+
+
+@pytest.mark.parametrize("result,state", [(2, 1), (2, 0xA), (3, 9), (0, 9), (1, 9)])
+def test_other_results_pass_through(badge_code, result, state):
+    got, seen = run_result(BadgeMachine(badge_code), result, state)
+    assert got == result and seen == []
