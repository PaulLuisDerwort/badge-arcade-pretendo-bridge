diff --git a/src/bridge_crane.py b/src/bridge_crane.py
new file mode 100644
index 0000000..1908605
--- /dev/null
+++ b/src/bridge_crane.py
@@ -0,0 +1,124 @@
+"""Pretendo Bridge: leave a crane machine with B while paid plays remain.
+
+The original game hides the bottom screen's Back button once plays are paid
+for and ignores it until the last play is over. These records keep Back
+active in that state and let the crane task end the session the same way it
+does after the last play, with the remaining plays dropped (see
+patches/bridge_crane.s). The addresses below are 1.3.0 values; the 1.3.1
+counterparts are in badge_versions.UPDATE.addresses, matched function by
+function against both executables.
+"""
+from __future__ import annotations
+
+from pathlib import Path
+import re
+import struct
+import subprocess
+import tempfile
+
+from badge_versions import Revision
+from patch_format import arm_branch
+
+ROOT = Path(__file__).resolve().parents[1]
+LOAD_ADDRESS = 0x100000
+
+# Dead body of the SDK's SOC GetHostByName: its entry branches to
+# badge_soc_unavailable, nothing else branches into it, and it is identical
+# in both revisions.
+CAVE = 0x1A5758
+CAVE_END = 0x1A57D0
+
+# Game functions the cave calls (1.3.0 addresses).
+EXTERNALS = {
+    "SET_STATE": 0x25CA78,
+    "PLAY_DONE": 0x2F9534,
+    "SESSION_REMAINING": 0x2554A4,
+    "GLOBAL_REMAINING": 0x252AA8,
+    "SESSION_END": 0x2E312C,
+    "SCREEN_EVENT_EXIT": 0x2F9934,
+}
+
+TASK_RESULT_CALL = 0x2DFBFC  # crane task update: "blx r1" (screen GetResult)
+STATE9_EXIT = 0x2F98CC       # screen button-release handler, state 9: "b exit"
+BACK_SHOWN = 0x241394        # state 9 button setup: Back SetVisible(0) -> 1
+BACK_ENABLED = 0x2413B0      # state 9 button setup: Back SetDisabled(1) -> 0
+
+R_ARM_CALL = 28
+R_ARM_JUMP24 = 29
+
+
+def _link(obj: bytes, load_address: int, externals: dict[str, int]) -> tuple[bytes, dict[str, int]]:
+    """.text of a clang ARM object with branches to `externals` resolved."""
+    shoff = struct.unpack_from("<I", obj, 32)[0]
+    shsize, shcount, shnames = struct.unpack_from("<HHH", obj, 46)
+    sections = [struct.unpack_from("<10I", obj, shoff + i * shsize) for i in range(shcount)]
+
+    def content(section):
+        return obj[section[4]:section[4] + section[5]]
+
+    def cstr(table, offset):
+        return table[offset:table.index(0, offset)].decode("ascii")
+
+    names = content(sections[shnames])
+    text_index = next(i for i, s in enumerate(sections) if cstr(names, s[0]) == ".text")
+    text = bytearray(content(sections[text_index]))
+    symbols = {}
+    for section in sections:
+        if section[1] != 2:  # SHT_SYMTAB
+            continue
+        table = content(sections[section[6]])
+        for offset in range(section[4], section[4] + section[5], section[9]):
+            n, value, _, _, _, index = struct.unpack_from("<IIIBBH", obj, offset)
+            if index == text_index and n:
+                symbols[cstr(table, n)] = load_address + value
+    for section in sections:
+        if section[1] not in (4, 9) or section[7] != text_index or not section[5]:
+            continue
+        if section[1] != 9:
+            raise ValueError("Unsupported ELF relocation section")
+        symtab = sections[section[6]]
+        strtab = content(sections[symtab[6]])
+        for offset in range(section[4], section[4] + section[5], 8):
+            position, info = struct.unpack_from("<II", obj, offset)
+            n, _, _, _, _, index = struct.unpack_from("<IIIBBH", obj, symtab[4] + (info >> 8) * symtab[9])
+            name = cstr(strtab, n)
+            kind = info & 0xFF
+            if kind not in (R_ARM_CALL, R_ARM_JUMP24) or index != 0 or name not in externals:
+                raise ValueError(f"Unsupported relocation {kind} against {name!r}")
+            old = struct.unpack_from("<I", text, position)[0]
+            if old & 0x00FFFFFF != 0x00FFFFFE:
+                raise ValueError("Unexpected ARM branch addend")
+            branch = struct.unpack("<I", arm_branch(load_address + position, externals[name]))[0]
+            # Keep the condition and the link bit of the assembled instruction.
+            struct.pack_into("<I", text, position, (old & 0xFF000000) | (branch & 0x00FFFFFF))
+    return bytes(text), symbols
+
+
+def crane_payload(revision: Revision) -> tuple[bytes, dict[str, int]]:
+    with tempfile.TemporaryDirectory(prefix="bridge-crane-") as temp:
+        source = (ROOT / "patches/bridge_crane.s").read_text()
+        source = re.sub(r"0x[0-9a-fA-F]+", lambda m: hex(revision.address(int(m[0], 16))), source)
+        assembly = Path(temp) / "crane.s"
+        assembly.write_text(source)
+        obj = Path(temp) / "crane.o"
+        subprocess.run(["clang", "-target", "arm-none-eabi", "-march=armv6k", "-c", str(assembly), "-o", str(obj)],
+                       check=True)
+        externals = {name: revision.address(address) for name, address in EXTERNALS.items()}
+        payload, symbols = _link(obj.read_bytes(), revision.address(CAVE), externals)
+    if len(payload) > revision.address(CAVE_END) - revision.address(CAVE):
+        raise ValueError("Crane payload exceeds its code cave")
+    return payload, symbols
+
+
+def crane_records(revision: Revision) -> list[tuple[int, bytes]]:
+    payload, symbols = crane_payload(revision)
+    call = revision.address(TASK_RESULT_CALL)
+    exit_branch = revision.address(STATE9_EXIT)
+    bl = struct.unpack("<I", arm_branch(call, symbols["bridge_crane_result"]))[0] | 0x01000000
+    return [
+        (revision.address(CAVE) - LOAD_ADDRESS, payload),
+        (call - LOAD_ADDRESS, struct.pack("<I", bl)),
+        (exit_branch - LOAD_ADDRESS, arm_branch(exit_branch, symbols["bridge_crane_back"])),
+        (revision.address(BACK_SHOWN) - LOAD_ADDRESS, bytes.fromhex("0110a0e3")),    # mov r1, #1
+        (revision.address(BACK_ENABLED) - LOAD_ADDRESS, bytes.fromhex("0010a0e3")),  # mov r1, #0
+    ]
